#include "pdhd_analysis_diagnostics_data.fcl"

BEGIN_PROLOG

pdhd_calorimetry_point_inventory_data_template: {
  module_type: "PDHDCalorimetryPointInventory"
  Mode: "data"
  ImplementationStatus: "template_only"
  EnabledForMode: true
  TrackTag: "pandoraTrack"
  CalorimetryTag: "pandoracalo"
}

END_PROLOG
