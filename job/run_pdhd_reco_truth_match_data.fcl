# Data runtime configuration for PDHDRecoTruthMatch.
#
# It writes the same reconstructed-track and Pandora beam-slice inventory as
# the MC job. MC matching and hierarchy branches remain explicitly invalid.

#include "messageservice.fcl"
#include "services_dune.fcl"
#include "pdhd_analysis_diagnostics_data.fcl"

process_name: PDHDRecoTruthMatchData

services: {
  TFileService: { fileName: "pdhd_reco_truth_match_data.root" }
  message: @local::standard_info
  WireReadout: @local::dune_wire_readout
  Geometry: @local::protodunehdv6_geo
}

source: {
  module_type: RootInput
  maxEvents: -1
}

outputs: {}

physics: {
  analyzers: {
    recoTruthMatch: @local::pdhd_reco_truth_match
  }
  analysis: [recoTruthMatch]
  end_paths: [analysis]
}

physics.analyzers.recoTruthMatch.EnableMCTruthMatching: false
