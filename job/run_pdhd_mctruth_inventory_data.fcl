# DATA FHiCL template for PDHDMCTruthInventory.
#
# Generator MCTruth records and primary particles with origin and product provenance.
# Truth products do not exist in detector data; this table stays disabled. Product labels below document the intended interface and must
# be validated against the input production before implementation.

#include "pdhd_analysis_diagnostics_data.fcl"

BEGIN_PROLOG

pdhd_mctruth_inventory_data_template: {
  module_type: "PDHDMCTruthInventory"
  Mode: "data"
  ImplementationStatus: "template_only"
  EnabledForMode: false
  MCTruthTags: ["generator"]
}

END_PROLOG
