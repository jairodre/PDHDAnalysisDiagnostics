# MC runtime configuration for PDHDRecoTruthMatch.
#
# The analyzer writes one event-level tree containing every Pandora track,
# its membership in the unique IsTestBeam slice, truth contributors, and the
# descendant Geant hierarchy of its energy-ranked match.

#include "messageservice.fcl"
#include "services_dune.fcl"
#include "pdhd_analysis_diagnostics_mc.fcl"

process_name: PDHDRecoTruthMatchMC

services: {
  TFileService: { fileName: "pdhd_reco_truth_match_mc.root" }
  message: @local::standard_info
  WireReadout: @local::dune_wire_readout
  Geometry: @local::protodunehdv6_geo
  DetectorClocksService: @local::protodunehd_detectorclocks
  BackTrackerService: @local::pdsp_backtrackerservice
  ParticleInventoryService: @local::dunefd_particleinventoryservice
}

services.BackTrackerService.BackTracker.G4ModuleLabel: "largeant"
services.BackTrackerService.BackTracker.SimChannelModuleLabel: "tpcrawdecoder:simpleSC"

source: {
  module_type: RootInput
  maxEvents: -1
}

outputs: {}

physics: {
  analyzers: {
    recoTruthMatch: @local::pdhd_reco_truth_match
  }
  analysis: [recoTruthMatch]
  end_paths: [analysis]
}

physics.analyzers.recoTruthMatch.EnableMCTruthMatching: true
physics.analyzers.recoTruthMatch.MCParticleTag: "largeant"
