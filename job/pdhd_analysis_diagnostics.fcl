# Base configuration for PDHDAnalysisDiagnostics. Beam analyzers are populated;
# remaining package modules are still templates and are not scheduled here.

#include "ProtoDUNEBeamlineUtils.fcl"

BEGIN_PROLOG

pdhd_analysis_diagnostics: {
  mode: "auto"
  schema_version: 0
  require_configured_products: false
}

pdhd_beam_instrumentation: {
  module_type: "PDHDBeamInstrumentation"
  DataBeamTag: "beamevent"
  MCBeamTag: "generator"
  MCTruthTag: "generator"
  NominalMomentumGeV: 1.0
  EvaluateDataPID: false
  EvaluateMCTrigger: false
  EvaluateMCPID: false
  # Conservative shared defaults. Runnable data/MC files override these with
  # the exact product construction and LLT-status provenance for that mode.
  BeamEventSourceDescription: "configured_beam_event_product"
  BeamEventBuildMethod: "consume_configured_product"
  BeamEventProducedInCurrentJob: false
  CherenkovStatusSource: "not_validated"
  CherenkovStatusProvenanceValid: false
  CherenkovPressureSource: "not_validated"
  CherenkovPressureProvenanceValid: false
  # Separate IFBeam-derived view. It becomes valid only after the precise 2024
  # PDHD channel mapping and BeamEvent timestamp convention are checked.
  IFBeamCherenkovSource: "not_validated"
  IFBeamCherenkovProvenanceValid: false
  IFBeamTimestampUnit: "unknown"
  IFBeamCKov0ChannelName: "not_configured"
  IFBeamCKov1ChannelName: "not_configured"
  NonNominalInputHandlingUsed: false
  # Also print endJob counters to stdout when LogInfo categories are filtered.
  PrintSummaryToStdout: true
  # Bound per-event diagnostics; the complete counts are printed at endJob.
  MaxEventMessages: 3
  # Print a BeamlineReco-style report for the first three eligible events.
  # Set MaxEventDetailPrintouts to 0 only for intentionally small test jobs.
  PrintEventDetailsToStdout: true
  MaxEventDetailPrintouts: 3
  # Keep every H4-VLE PDHD profile monitor in the diagnostic output.
  FiberMonitorNames: ["XBPF022697", "XBPF022698", "XBPF022701", "XBPF022702", "XBPF022707", "XBPF022708", "XBPF022716", "XBPF022717"]
  BeamlineUtils: @local::standard_protodunebeamlineutils
}

pdhd_beam_selection_stages: {
  module_type: "PDHDBeamSelectionStages"
  DataBeamTag: "beamevent"
  MCBeamTag: "generator"
  PFParticleTag: "pandora"
  # Separate tags make the Pandora beam-slice source auditable.
  PFParticleMetadataTag: "pandora"
  PFParticleSliceTag: "pandora"
  TrackTag: "pandoraTrack"
  ShowerTag: "pandoraShower"
  # Passed to BeamInstrumentationAlg only. PID evaluation is disabled here,
  # so it does not define a candidate cut or any beam--TPC threshold.
  BeamInstrumentationNominalMomentumGeV: 5.0
  # A candidate has exactly one reconstructed representation: track or shower.
  # A PFP with both types, multiple objects, or neither is kept as diagnostic
  # output but cannot pass. Neither type is silently preferred.
  RequireGoodDataTrigger: true
  RequireGoodMCTrigger: true
  # The nominal conjunction stops at event quality, one beamline track,
  # Pandora beam-slice primary, and one unambiguous reconstructed object. The
  # endpoint/entry residuals below are stored for a later HD-specific cut.
  # Tracks use a local lower-Z-entry chord; showers use ShowerStart/Direction.
  TPCEntryDirectionLengthCm: 5.0
  # Also print endJob counters to stdout when LogInfo categories are filtered.
  PrintSummaryToStdout: true
  # Bound per-event messages; endJob always reports complete counters.
  MaxEventMessages: 3
  BeamlineUtils: @local::standard_protodunebeamlineutils
}

END_PROLOG
