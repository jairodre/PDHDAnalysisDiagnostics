# MC-mode scaffold for shared diagnostic configuration. It records only the
# intended mode; scheduling is owned by the including job. Truth and
# backtracking products must still be checked per event.

#include "pdhd_analysis_diagnostics.fcl"

BEGIN_PROLOG

pdhd_analysis_diagnostics_mc: @local::pdhd_analysis_diagnostics
pdhd_analysis_diagnostics_mc.mode: "mc"

END_PROLOG
