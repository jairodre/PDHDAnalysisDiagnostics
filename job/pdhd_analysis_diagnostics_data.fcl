# Data-mode scaffold for shared diagnostic configuration. It records only the
# intended mode; scheduling is owned by the including job. Truth analyzers must
# remain disabled for real data.

#include "pdhd_analysis_diagnostics.fcl"

BEGIN_PROLOG

pdhd_analysis_diagnostics_data: @local::pdhd_analysis_diagnostics
pdhd_analysis_diagnostics_data.mode: "data"

END_PROLOG
